# ========================================
# Padel Club OS - Variables de Entorno
# ========================================
# Copia este archivo como .env y rellena los valores.
# Las variables con NEXT_PUBLIC_ son visibles en el navegador.

# --- Etapa de lanzamiento ---
# pilot admite exclusivamente Stripe TEST y no exige la confirmacion fiscal final.
# commercial es el valor seguro por defecto y exige Stripe LIVE + confirmacion fiscal.
LAUNCH_STAGE="pilot"

# --- Base de datos PostgreSQL (requerido) ---
# En Vercel, DATABASE_URL usa Supavisor en modo transaccion, puerto 6543, con
# `pgbouncer=true&connection_limit=1`. DIRECT_URL usa Supavisor en modo sesion,
# puerto 5432, para migraciones y tareas administrativas. Ninguna requiere el
# complemento IPv4. En local ambas pueden apuntar al mismo PostgreSQL de desarrollo.
# NUNCA uses la base de produccion en local. Ver docs/supabase-go-live.md.
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/padel_club_os"
DIRECT_URL="postgresql://usuario:contrasena@localhost:5432/padel_club_os"

# --- Autenticacion NextAuth (requerido) ---
# Generar con: openssl rand -base64 32
AUTH_SECRET="generar-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe - Suscripciones SaaS de clubes (requerido si facturacion activa) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER_MONTHLY="price_..."
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..."
# Configuracion del Customer Portal con upgrades prorrateados y downgrades al renovar.
STRIPE_PORTAL_CONFIGURATION_ID="bpc_..."

# --- Email con Resend (requerido si emails activos) ---
RESEND_API_KEY="re_..."
CONTACT_EMAIL="contacto@tudominio.com"

# --- Notificaciones Push VAPID (requerido si push activo) ---
# Generar par de claves con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contacto@tudominio.com"

# --- Almacenamiento de imagenes (obligatorio en produccion) ---
# Token Read/Write de un store de Vercel Blob vinculado al proyecto.
BLOB_READ_WRITE_TOKEN=""

# --- Cron Jobs (requerido si recordatorios activos) ---
# Token secreto para autorizar llamadas a /api/cron/*
CRON_SECRET="generar-token-aleatorio"

# --- Heartbeats de crons con healthchecks.io (obligatorio en produccion) ---
# Ping URLs de healthchecks.io (una por cron). Al terminar con exito, cada cron
# hace un GET a su URL; si el ping no llega, healthchecks.io avisa por email.
# Sin valor (local, CI) no se envia nada. Ver docs/operacion.md.
HEARTBEAT_URL_REMINDERS=""
HEARTBEAT_URL_RECURRING=""
HEARTBEAT_URL_REFUNDS=""

# --- SEO y URLs publicas ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Identidad legal publica (sobrescrituras opcionales) ---
# La aplicacion ya contiene estos datos publicos por defecto. Estas variables solo
# son necesarias si cambia la sociedad y deben coincidir con Stripe y las facturas.
LEGAL_ENTITY_TYPE="company"
LEGAL_NAME="BORT PEREZ MULTI GESTION SOCIEDAD LIMITADA"
LEGAL_TAX_ID="B98629470"
LEGAL_PUBLIC_ADDRESS="Avenida Carlos Marx, 1, 12 E, 46920 Mislata, Valencia, España"
LEGAL_REGISTRY_DETAILS="Inscrita en el Registro Mercantil de Valencia, tomo 9786, libro 7068, folio 52, sección 8, hoja V-159244"
LEGAL_EMAIL="albertobort@gmail.com"

# --- Stripe Tax ---
# Mantener false hasta completar en Stripe: origen fiscal, registro(s), tax code de
# los productos y tax_behavior de los prices. Luego probar en TEST antes de LIVE.
STRIPE_TAX_ENABLED="false"
# Confirmacion humana de que la sociedad emite las facturas y las entrega cada mes
# a la gestoria. No afirma que Stripe Tax sea obligatorio.
TAX_HANDLING_CONFIRMED="false"

# --- Rate Limiting distribuido ---
# "database" usa PostgreSQL y no requiere otro proveedor. "upstash" es opcional
# si se desea descargar estos contadores de la base principal.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# En produccion: "database" o "upstash". "memory" solo en local/tests.
RATE_LIMIT_BACKEND="database"

# --- Bootstrap y demo comercial (solo durante el seed inicial) ---
# Usa tres contraseñas distintas, largas y generadas en un gestor. Estas variables
# se cargan en una terminal controlada y se retiran al terminar. No se necesitan en
# el runtime de Vercel y nunca deben incluirse en Git.
BOOTSTRAP_SUPERADMIN_EMAIL="albertobort@gmail.com"
BOOTSTRAP_SUPERADMIN_PASSWORD=""
DEMO_CLUB_NAME="Club Pádel Demo"
DEMO_CLUB_SLUG="club-padel-demo"
DEMO_ADMIN_PASSWORD=""
DEMO_PLAYER_PASSWORD=""

# --- Monitoring con Sentry (obligatorio en produccion) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Solo necesario en CI/produccion para subir source maps
SENTRY_AUTH_TOKEN=""
